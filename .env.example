# Required server secrets. Generate unique values; never commit the real file.
JWT_SECRET=replace-with-a-random-32-byte-secret
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-16-characters

# Public/origin checks
NEXTAUTH_URL=http://localhost:4000
APP_PUBLIC_URL=http://localhost:4000

# Persistent SQLite data directory
THREADS_DATA_DIR=./data

# Scheduler safety
MAX_POSTS_PER_DAY=288

# Hermes CLI / OpenAI-compatible provider
HERMES_PROVIDER=openai-compatible
HERMES_MODEL=your-model
# HERMES_BASE_URL=https://api.example.com/v1
# HERMES_API_KEY=replace-with-provider-key
# HERMES_BIN=hermes

# Threads OAuth/API (needed only for real publishing)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/threads/callback
TOKEN_ENCRYPTION_KEY=replace-with-a-separate-random-secret

# Docker host binding
APP_PORT=4000
